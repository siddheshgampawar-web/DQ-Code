.codes-2col-grid {
  display:flex; justify-content:center; align-items:flex-start; gap: 40px; width:100%;
  max-width:900px; margin-top:8px;
}
.codes-ulist {
  width:100%; padding-left: 0; margin: 0; list-style: none;
  display: flex; flex-direction: column; gap: 6px; max-width:400px; min-width:200px;
}
.codes-li {
  padding:0; margin:0; width: 99%; display: block;
}
.codes-link, .codes-link:visited {
  display: block;
  width: 100%;
  background: var(--blue3);
  color: #1367be;
  font-size: 1rem;
  font-weight: 500;
  border-radius: 8px;
  padding: 13px 14px 13px 22px;
  margin-bottom: 1px;
  transition: background 0.19s, color .11s;
  text-decoration:none; border: none; cursor: pointer; text-align:left;

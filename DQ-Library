<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Pattern Automation Portal</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
:root {
  --blue1: #e3f0fc;
  --blue2: #3566a8;
  --blue3: #ddeaff;
  --white: #fcfcfc;
  --shadow: 0 2px 14px rgba(33,60,138,0.07);
  --internalIconColor: #193a83;
}
html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  min-height: 100vh;
  font-family: 'Segoe UI', Arial, sans-serif;
  background: linear-gradient(135deg, var(--blue1) 60%, var(--blue2) 100%);
}
body {
  min-height: 100vh;
  background: linear-gradient(135deg, var(--blue1) 60%, var(--blue2) 100%);
}
.main-app-container {
  margin: 0 auto;
  min-width: 315px;
  max-width: 1600px;
  min-height: 100vh;
  background: var(--white);
  box-shadow: 0 1px 18px rgba(50,80,120,.05);
}
.header-bar {
  width: 100%;
  background: var(--white);
  box-shadow: 0 2px 12px rgba(120,150,180,.07);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  position: relative;
  z-index: 10;
  min-height: 80px;
}
.header-left, .header-right {
  display: flex;
  align-items: center;
  height: 80px;
}
.header-left {
  min-width: 170px;
  padding-left: 18px;
}
.name {
  font-size: 1rem;
  color: #325088;
  font-weight: 500;
  background: #EDF6FF;
  border-radius: 7px;
  padding: 6px 19px 7px 12px;
  user-select: none;
  box-shadow: 0 1px 8px rgba(50,80,120,.05);
}
.header-right {
  min-width: auto;
  padding-right: 18px;
}
.global-search-container {
  display: flex;
  align-items: center;
  background: var(--white);
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(33,60,138,0.12);
  padding: 0 10px 0 6px;
  min-width: 190px;
  max-width: 258px;
  width: 100%;
  height: 37px;
  margin-top: 3px;
  margin-bottom: 3px;
  border: 1px solid #c3daff;
}
.global-search-icon {
  font-size: 1.02rem;
  color: #3566a8;
  margin-right: 5px;
}
.global-search-input {
  font-size: 1rem;
  border: none;
  outline: none;
  background: transparent;
  color: #274176;
  width: 100%;
  min-width:60px;
  max-width:190px;
  padding: 8px 0 8px 0;
}
.global-search-suggest {
  position: absolute;
  top: 47px;
  right: 0;
  width: 258px;
  background: #f3faff;
  border: 1px solid #b6cffa;
  border-radius: 7px;
  box-shadow: 0 2px 8px rgba(33,60,138,.09);
  max-height: 170px;
  overflow-y: auto;
  display: none;
  padding: 2px 0;
  z-index: 999;
}
.global-search-suggest.open { display: block; }
.global-search-suggest-item {
  padding: 7px 18px;
  cursor: pointer;
  color: #125ad3;
  font-size: .99rem;
  border-bottom: 1px solid #e3f0fc;
  background: #f3faff;
}
.global-search-suggest-item:last-child {border-bottom:none;}
.global-search-suggest-item:hover {
  background: #ddeaff; color:#2a277a;
}
.header-center {
  left: 0; right: 0; top: 0;
  height: 80px;
  position: absolute;
  width: 100vw;
  z-index:0;
  pointer-events: none;
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.dqteam, .pattern-title {
  font-size: 2rem;
  font-weight: bold;
  color: #235bb7;
  letter-spacing: 2px;
  background: linear-gradient(90deg, #b2cdfc 70%, #f2f6fa 100%);
  border-radius: 12px;
  text-align: center;
  padding: 6px 32px 7px 32px;
  margin-bottom: 2px;
  box-shadow: 0 1px 7px rgba(100,127,180,.08);
  user-select: none;
  pointer-events:auto;
}
.pattern-title {
  color: #2b59a5;
  margin-top: 0;
  margin-bottom: 0;
}
@media (max-width: 1100px) {
  .main-app-container {max-width: 98vw;}
  .codes-2col-grid {gap:18px;}
  .codes-ulist {max-width:95vw;}
  .center-content {max-width:98vw;}
  .sidebar, .sidebar-right {width:180px;max-width:220px;min-width:110px;}
  .header-bar {min-height:60px;}
  .header-left, .header-right {height: 60px;}
  .header-center {height: 60px;}
  .dqteam, .pattern-title {font-size:1.2rem; padding: 2px 12vw;}
}
@media (max-width: 800px) {
  .container-main {flex-direction:column;}
  .sidebar, .sidebar-right {display:none;}
  .center-content {margin:13px 2vw;}
  .codes-link {font-size:0.97rem;padding:9px 6px;}
  .codes-title {margin-top:9px;}
  .codes-2col-grid {flex-direction:column; gap:8px;}
  .global-search-suggest {width: 95vw; left: 0;}
  .main-app-container {max-width:100vw;}
}
.container-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;

  cursor: pointer; width:93%; font-weight: 470;
  gap:7px;
}
.expand-link.sheet-link svg {
  min-width: 19px; min-height: 19px; margin-right: 4px;
}
.expand-link.internal-link svg {
  min-width: 19px; min-height: 19px; margin-right: 4px;
}
.expand-link.platform-amazon svg { min-width:20px;min-height:20px;margin-right:4px;}
.expand-link.platform-walmart svg { min-width:20px;min-height:20px;margin-right:4px;}
.expand-link.platform-ebay {color: #0064d2;}
.expand-link.platform-ebay svg {margin-right:4px;}
.expand-link.platform-macys {color: #cb333b;}
.expand-link.platform-target svg {margin-right:4px;min-width:20px;min-height:20px;}
.expand-link:hover {background: #bbdefb; color: #0f234c;}
.center-content {
  flex-grow:1; margin: 25px 12px 18px 12px; display: flex; flex-direction: column;
  align-items: center; min-width: 330px; max-width: 1000px;
}
.codes-title {
  font-weight:700; font-size:1.14rem; color: #1c336b; margin-bottom: 10px; margin-top:10px; user-select:none;

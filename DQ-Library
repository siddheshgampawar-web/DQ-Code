.searchinput {
  font-size: 1.06rem; border: 1.5px solid #d3e3fa; border-radius: 7px;
  padding: 6px 14px; outline: 0; margin-bottom: 10px; min-width: 230px;
  background: var(--blue3); color: #14204a;
  box-shadow: 0 1px 8px rgba(50,80,120,.06);
  transition: border 0.18s;
  max-width: 320px;
}
.searchinput:focus { border: 1.5px solid #306aad;}
.pattern-chat-center {
  margin-bottom: 18px;
  margin-top: -2px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}
.pattern-chat-link {
  display: inline-block;
  font-size: 1.08rem;
  font-weight: 570;
  color: #125ad3;

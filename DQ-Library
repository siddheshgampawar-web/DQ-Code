<script>
function toggleSection(id, arrowId){
  var el = document.getElementById(id);
  var arr = document.getElementById(arrowId);
  if(el.classList.contains("open")){
    el.classList.remove("open"); arr.style.transform="rotate(0)";
  } else {
    el.classList.add("open"); arr.style.transform="rotate(180deg)";
  }
}
document.addEventListener("DOMContentLoaded",function(){
  toggleSection('sheetSection','sheetArrow');
  // Ensure videos section are closed:
  document.getElementById('dqtrainingSection').style.display = 'none';
  document.getElementById('dqtrainingArrow').style.transform = "rotate(0deg)";
  document.getElementById('trainingSection').style.display = 'none';
  document.getElementById('trainingArrow').style.transform = "rotate(0deg)";
  document.getElementById('platformSection').classList.add('open');
  document.getElementById('sellerSection').classList.add('open');
});

// Codes search
function filterCodes2Col(){
  var input = document.getElementById("searchCodes");
  var filter = input.value.toUpperCase();
  function filterList(ulId){
    var ul = document.getElementById(ulId);
    var lis = ul.getElementsByClassName("codes-li");
    var visibleCount = 0;
    for (var i = 0; i < lis.length; i++) {
      var a = lis[i].getElementsByTagName("a")[0];
      var textValue = a.textContent || a.innerText;
      if (textValue.toUpperCase().indexOf(filter) > -1) {
        lis[i].style.display = "";
        visibleCount++;
      } else {
        lis[i].style.display = "none";
      }
    }
    ul.style.display = visibleCount>0 ? "" : "none";
  }
  filterList("codesUListLeft");
  filterList("codesUListRight");
}

// Global search (top right)
const globalSearchEl = document.getElementById('globalSearchInput');
const suggestEl = document.getElementById('globalSearchSuggest');
function getAllSearchableLinks() {
  let links = Array.from(document.querySelectorAll('a, .codes-title, .dqteam, .pattern-title, .name, .section-title'));
  let items = [];
  links.forEach(el => {
    let text = (el.textContent || el.innerText).trim();
    if (text && text.length > 1) {
      items.push({
        text: text,
        href: el.href && el.href.startsWith('http') ? el.href : null,
        node: el
      });
    }
  });
  return items;
}
let allPageItems = getAllSearchableLinks();
globalSearchEl.addEventListener('input', function() {
  let value = globalSearchEl.value.trim().toLowerCase();
  suggestEl.innerHTML = '';
  if (!value) {
    suggestEl.style.display = 'none';
    return;
  }
  let matches = allPageItems.filter(item => item.text.toLowerCase().includes(value));
  if (matches.length) {
    matches.slice(0,12).forEach(m=>{
      const div = document.createElement('div');
      div.className = 'global-search-suggest-item';
      div.textContent = m.text;
      div.onclick = () => {
        if (m.href) {
          window.open(m.href, "_blank");
        } else if (m.node && m.node.scrollIntoView) {
          m.node.scrollIntoView({behavior: 'smooth', block:'center'});
          m.node.style.background = '#ffe173';
          setTimeout(()=> { m.node.style.background=''; }, 1200);
        }
        suggestEl.style.display = 'none';
      };
      suggestEl.appendChild(div);
    });
    suggestEl.style.display = 'block';
  } else {
    suggestEl.style.display = 'none';
  }
});
document.addEventListener('click', function(e){
  if (!globalSearchEl.contains(e.target) && !suggestEl.contains(e.target)) {
    suggestEl.style.display='none';
  }
});
globalSearchEl.addEventListener('keydown',function(e){
  let openSuggest = suggestEl.querySelector('.global-search-suggest-item');
  if (e.key==='Enter' && openSuggest) {
    openSuggest.click();
    e.preventDefault();
  }
});
</script>
